<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- taller card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:minHeight="600dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        android:background="@android:color/white"
        android:padding="32dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Large centered icon on top -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_profile_picture"
            app:tint="#6200EE"
            android:contentDescription="Profile Icon"
            android:layout_marginBottom="32dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Profile"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="32dp" />

        <!-- Info rows with bigger fonts and spacing -->

        <!-- Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#6200EE"
                android:contentDescription="Name Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="John Doe"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Age -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="#6200EE"
                android:contentDescription="Age Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Age:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="35"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Gender -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#6200EE"
                android:contentDescription="Gender Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Male"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Condition -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#6200EE"
                android:contentDescription="Condition Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Condition:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvCondition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Diabetes"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Contact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#6200EE"
                android:contentDescription="Contact Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1234567890"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Health Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#6200EE"
                android:contentDescription="Health Info Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health Info:"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:textSize="18sp"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvHealthInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blood Pressure: Normal\nAllergies: None"
                android:textColor="#444444"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
    </ScrollView>
